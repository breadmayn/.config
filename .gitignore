# ignore all files to create allowlist pattern for .gitignore
# check using: `git status --short --untracked-files=all`
/*

# allowlist
!.gitignore
!/README.md
!/zsh/
!/nvim/
!/tmux/
!/ghostty/
!/setup/
!setup.sh

# explict deny list
.DS_Store
*.local
.zcompdump*
.zsh_history
.zsh_sessions/
.zcompcache/

